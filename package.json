{
  "name": "the-binary-game",
  "version": "2.0.0",
  "private": true,
  "author": "Loïc Viennois",
  "description": "A fast-paced puzzle game for learning binary numbers",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/generate-git-info.mjs",
    "prebuild": "node scripts/generate-git-info.mjs",
    "build": "tsc -b && vite build",
    "dev": "vite",
    "prestart": "node scripts/generate-git-info.mjs",
    "start": "vite --host 0.0.0.0",
    "prelint": "node scripts/generate-git-info.mjs",
    "lint": "eslint .",
    "pretest": "node scripts/generate-git-info.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@eslint/js": "^9.37.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  }
}
