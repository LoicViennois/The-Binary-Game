{
  "name": "the-binary-game",
  "author": "Loïc Viennois",
  "description": "The Binary Game",
  "license": "GPLv3",
  "main": "main.js",
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "ng": "ng",
    "prebuild": "node scripts/generate-git-info.mjs",
    "build": "ng build --configuration production",
    "prestart": "node scripts/generate-git-info.mjs",
    "start": "ng serve",
    "prelint": "node scripts/generate-git-info.mjs",
    "lint": "ng lint",
    "pretest": "node scripts/generate-git-info.mjs",
    "test": "playwright test",
    "pree2e": "node scripts/generate-git-info.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.23",
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/platform-browser": "^21.2.23",
    "@angular/platform-browser-dynamic": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@angular/service-worker": "^21.2.23",
    "@fortawesome/fontawesome-free": "^5.14.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "bootstrap": "~4.6.2",
    "lodash": "~4.17.20",
    "rxjs": "~7.8.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.24",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.23",
    "@playwright/test": "^1.63.0",
    "@types/lodash": "^4.14.161",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.9.3"
  }
}
